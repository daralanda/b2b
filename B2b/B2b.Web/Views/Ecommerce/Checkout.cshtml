@using System.Configuration;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Domain = Context.Request.Scheme + "://" + this.Context.Request.Host.Value;
}
<div class="checkout-tabs">
    <div class="row">
        <div class="col-xl-12 col-sm-12">
            <div class="card">
                <div class="card-body">
                    <div class="tab-content" id="v-pills-tabContent">
                        <div class="tab-pane fade active show" id="v-pills-payment" role="tabpanel" aria-labelledby="v-pills-payment-tab">
                            <div class="row">
                                <div class="col-md-3 col-sm-12">
                                    <h4 class="card-title">Ödeme Bilgileri</h4>
                                    <h6 id="CheckOutTotalPrice">Ödenecek Tutar  :  </h6>
                                    <div class="form-group">
                                        <label for="example-textarea" class="col-md-2 col-form-label">Sipariş Notu:</label>
                                        <div class="col-md-10">
                                            <textarea class="form-control" id="textarea" rows="3" placeholder="Sipariş Notunuz"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-9 col-sm-12">
                                    
                                    <ul class="nav nav-tabs nav-tabs-custom nav-justified mt-2" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active p-0" data-bs-toggle="tab" onclick="PaymentType(1)" href="#home1" role="tab">
                                                <span class="d-block d-sm-none"><img src="~/assets/images/icon/kredikart-sm.jpg" class="checkout-icon-sm"/></span>
                                                <span class="d-none d-sm-block"><img src="~/assets/images/icon/kredikart.jpg" class="checkout-icon" /></span>                                           </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link p-0" data-bs-toggle="tab" onclick="PaymentType(2)" href="#profile1" role="tab">
                                                <span class="d-block d-sm-none"><img src="~/assets/images/icon/havale-sm.jpg" class="checkout-icon-sm" /></span>
                                                <span class="d-none d-sm-block"><img src="~/assets/images/icon/havale.jpg" class="checkout-icon" /></span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link p-0" data-bs-toggle="tab" onclick="PaymentType(3)" href="#messages1" role="tab">
                                                <span class="d-block d-sm-none"><img src="~/assets/images/icon/bakiye-sm.jpg" class="checkout-icon-sm" /></span>
                                                <span class="d-none d-sm-block"><img src="~/assets/images/icon/bakiye.jpg" class="checkout-icon" /></span>
                                            </a>
                                        </li>

                                    </ul>
                        
                                    <!-- Tab panes -->
                                    <div class="tab-content p-3 text-muted">
                                        <div class="tab-pane active" id="home1" role="tabpanel">
                                            <div class="col-md-4">
                                                <a href="#" onclick="payWithModal()" class="btn btn-success">
                                                    <i class="fas fa-credit-card font-size-24"></i> Kredi Kartı Öde
                                                </a>
                                            </div>
                                        </div>
                                        <div class="tab-pane" id="profile1" role="tabpanel">
                                            <table class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Logo</th>
                                                        <th>Banka</th>
                                                        <th>Hesap Sahibi Adı</th>
                                                        <th>Hesap Numarası</th>
                                                        <th>Şube Kodu</th>
                                                        <th>Para Birimi</th>
                                                        <th>IBAN</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="AccountInformation"></tbody>
                                            </table>
                                        </div>
                                        <div class="tab-pane" id="messages1" role="tabpanel">
                                            <p class="mb-0">
                                                Ödeme tutarınız bakiyenize eklenecektir.
                                            </p>
                                        </div>

                                    </div>
                                    <div class="row mt-4">
                                        <div class="col-sm-6">
                                            <a href="#" onclick="Next('Shipping')" class=" btn  btn-danger">
                                                <i class="mdi mdi-arrow-left me-1"></i> Geri
                                            </a>
                                        </div> <!-- end col -->
                                        <div class="col-sm-6">
                                            <div class="text-end">
                                                <a href="#" class="btn btn-success" onclick="Next('Confirm')">
                                                    <i class="mdi mdi-truck-fast me-1"></i> Siparişi Tamamla
                                                </a>
                                            </div>
                                        </div> <!-- end col -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade " id="v-pills-confir"  role="tabpanel" aria-labelledby="v-pills-confir-tab">
                            <div class="card shadow-none border mb-0">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Sipariş Özeti</h4>

                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0 table-nowrap">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col">Ürün</th>
                                                    <th scope="col">Ürün Adı</th>
                                                    <th scope="col">Birim</th>
                                                    <th scope="col">Adet</th>
                                                    <th scope="col">Fiyat</th>
                                                    <th scope="col">Satır Toplam</th>
                                                </tr>
                                            </thead>
                                            <tbody id="confrmTableContent">
                                               
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
         <!-- end row -->
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Güvenli Ödeme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="paymentFrame" src="" style="width:100%; height:600px; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Domain/controllerjs/home/Checkout.js"></script>
}

