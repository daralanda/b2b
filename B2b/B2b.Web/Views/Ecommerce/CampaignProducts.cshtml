@using System.Configuration;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Domain = Context.Request.Scheme + "://" + this.Context.Request.Host.Value;
}

<div class="mt-4">
    <div class="row">
        <div class="col-12 mb-3">
            <div class="p-3 bg-light rounded shadow-sm">
                <div class="row g-3 align-items-center">
                    
                    <div class="col-12 col-md-3">
                        <input type="text" id="searchInput" class="form-control" placeholder="Ürün veya kod ara...">
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <select id="category-list" class="form-select">
                            <option value="">Tüm Kategoriler</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <select id="brand-filter" class="form-select">
                            <option value="">Tüm Markalar</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <select id="sortSelect" class="form-select">
                            <option value="">Sıralama Seçiniz</option>
                            <option value="priceAsc">Fiyat: Düşükten Yükseğe</option>
                            <option value="priceDesc">Fiyat: Yüksekten Düşüğe</option>
                            <option value="nameAsc">Ad: A'dan Z'ye</option>
                            <option value="nameDesc">Ad: Z'den A'ya</option>
                        </select>
                    </div>

                    <div class="col-6 col-sm-3 col-md-1 text-end">
                        <div class="btn-group w-100" role="group" aria-label="Görünüm Seçimi">
                            <button type="button" id="btn-grid" class="btn btn-outline-secondary active">
                                <i class="bx bx-grid-alt"></i>
                            </button>
                            <button type="button" id="btn-list" class="btn btn-outline-secondary">
                                <i class="bx bx-list-ul"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-6 col-sm-3 col-md-2" id="clearFiltersArea" class="d-none">
                        <button id="btnClearFilters" class="btn btn-danger w-100">
                            <i class="mdi mdi-filter-remove-outline me-1"></i> Temizle
                        </button>
                    </div>

                </div>
            </div>
        </div>
        
        <div class="col-12 mt-2">
            <div id="product-list" class="row g-4"></div>

            <div id="pagination-container" class="mt-4 d-flex justify-content-center"></div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="@Domain/assets/libs/paginationjs/pagination.css">
    <script src="@Domain/assets/libs/paginationjs/pagination.min.js"></script>
    <script src="@Domain/controllerjs/home/CampaignProducts.js"></script>
}