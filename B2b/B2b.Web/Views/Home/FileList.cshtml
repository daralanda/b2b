@using System.Configuration;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Domain = Context.Request.Scheme + "://" + this.Context.Request.Host.Value;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <!-- Skote Toolbar / Search Row -->
                <div class="row mb-3 align-items-center">
                    <div class="col-md-5 col-sm-12 mb-2 mb-md-0">
                        <div class="search-box">
                            <div class="position-relative">
                                <input type="text" id="fileSearchInput" class="form-control bg-light border-light rounded" placeholder="Dosya ara...">
                                <i class="bx bx-search-alt search-icon position-absolute top-50 translate-middle-y ms-2 text-muted"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7 col-sm-12">
                        <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                            <div class="d-flex align-items-center gap-1">
                                <label for="sortBy" class="form-label mb-0 me-1 text-muted">Sırala:</label>
                                <select id="sortBy" class="form-select form-select-sm w-auto">
                                    <option value="Name">Dosya Adı</option>
                                    <option value="Size">Boyut</option>
                                    <option value="CreatedDate">Tarih</option>
                                </select>

                                <select id="sortOrder" class="form-select form-select-sm w-auto">
                                    <option value="asc">Artan</option>
                                    <option value="desc">Azalan</option>
                                </select>
                            </div>

                            <button id="btnRefresh" class="btn btn-sm btn-soft-secondary ms-1">
                                <i class="bx bx-refresh fs-5 align-middle"></i> Yenile
                            </button>

                            <!-- Dosya Yükle Butonu -->
                            <button id="btnOpenUploadModal" class="btn btn-sm btn-primary ms-1" data-bs-toggle="modal" data-bs-target="#fileUploadModal">
                                <i class="bx bx-upload fs-5 align-middle me-1"></i> Dosya Yükle
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Skote Responsive Grid Container -->
                <div id="fileGrid" class="row"></div>

            </div>
        </div>
    </div>
</div>

<!-- Çoklu Dosya Yükleme Modalı -->
<div class="modal fade" id="fileUploadModal" tabindex="-1" aria-labelledby="fileUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fileUploadModalLabel"><i class="bx bx-cloud-upload me-1 text-primary"></i> Dosya Yükle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <!-- Sürükle Bırak Alanı -->
                <div id="dropZone" class="border border-2 border-dashed rounded-3 p-4 text-center bg-light position-relative mb-3" style="cursor: pointer;">
                    <input type="file" id="fileInput" multiple class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;">
                    <i class="bx bx-cloud-upload display-3 text-primary mb-2"></i>
                    <h5>Dosyaları buraya sürükleyin veya tıklayarak seçin</h5>
                    <p class="text-muted font-size-12 mb-0">Birden fazla dosya seçebilirsiniz.</p>
                </div>

                <!-- Seçilen Dosyaların Listesi -->
                <div id="selectedFilesContainer" class="d-none">
                    <h6 class="font-size-13 mb-2">Seçilen Dosyalar:</h6>
                    <ul id="selectedFilesList" class="list-group list-group-flush border rounded overflow-auto" style="max-height: 200px;"></ul>
                </div>

                <!-- Progress Bar -->
                <div id="uploadProgressContainer" class="progress mt-3 d-none" style="height: 10px;">
                    <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="btnUploadSubmit" class="btn btn-primary btn-sm" disabled>
                    <i class="bx bx-upload me-1"></i> Yüklemeyi Başlat
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Skote File Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" aria-labelledby="filePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-truncate" id="filePreviewModalLabel">Dosya Ön İzleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0 text-center bg-light d-flex align-items-center justify-content-center" style="min-height: 400px; max-height: 75vh; overflow: auto;">
                <div id="previewContainer" class="w-100 h-100 d-flex align-items-center justify-content-center p-3"></div>
            </div>
            <div class="modal-footer justify-content-between">
                <span id="previewFileInfo" class="text-muted font-size-12"></span>
                <div>
                    <a id="btnPreviewDownload" href="#" target="_blank" class="btn btn-primary btn-sm">
                        <i class="bx bx-download me-1"></i> Dosyayı Aç / İndir
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Domain/ControllerJs/Definitions/FileList.js"></script>
}