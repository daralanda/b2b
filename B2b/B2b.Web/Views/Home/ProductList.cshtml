@using System.Configuration;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Domain = Context.Request.Scheme + "://" + this.Context.Request.Host.Value;
}

<div class="col-12">
    <div class="card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6 col-sm-12">
                    <div class="row align-items-center">
                        <div class="col-auto">Ürün Toplu Yükleme</div>
                        <div class="col-auto">
                            <input type="file" id="fileInput" class="form-control" name="file" accept=".xlsx" required />
                        </div>
                        <div class="col-auto">
                            <a href="#" onclick="uploadExcel()" id="uploadLink" class="btn btn-primary"> Yükle</a>
                        </div>
                        <div class="col-auto"><a href="/uploads/Stok.xlsx" class="btn btn-success">Şablon İndir</a></div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="row align-items-center">
                        <div class="col-auto">Ürün Toplu Güncelleme</div>
                        <div class="col-auto">
                            <input type="file" id="fileInput2" class="form-control" name="file" accept=".xlsx" required />
                        </div>
                        <div class="col-auto">
                            <a href="#" onclick="uploadExcel2()" id="uploadLink" class="btn btn-primary"> Yükle</a>
                        </div>
                        <div class="col-auto"><a class="btn btn-success" onclick="GetProductPriceTemplate()">Şablon İndir</a></div>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div id="uploadResult" class="mt-3"></div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12" style="text-align: right;">
                    <a onclick='btnClick(this)' id="new" class="btn btn-primary insert text-white pull-right insert" data-bs-toggle="modal" data-bs-target="#exampleModal"><i class="mdi mdi-plus-circle mr-1"></i> Yeni Ürün Ekle</a>
                </div>
            </div>

            <table class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;" id="datatables">
                <thead>
                    <tr>
                        <th>Ürün Resim</th>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Marka</th>
                        <th>Stok Durumu</th>
                        <th>Barkod</th>
                        <th>Birim İçi Adet</th>
                        <th>Para Birimi</th>
                        <th>Varsayılan Mı</th>
                        <th>Fiyat</th>
                        <th>Birim</th>
                        <th>Açıklama</th>
                        <th>Vergi Oranı</th>
                        <th>Resim Link</th>
                        <th>Durumu</th>
                        <th width="95px"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div> <!-- end card-body-->
    </div> <!-- end card-->
</div> <!-- end col -->
@section scripts {
    <!-- Datatables & Libraries -->
    <link href="@Domain/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="@Domain/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="@Domain/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="@Domain/assets/libs/dropzone/dropzone.css" rel="stylesheet" type="text/css" />

    <script src="@Domain/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
    <script src="@Domain/assets/libs/jszip/jszip.min.js"></script>
    <script src="@Domain/assets/libs/pdfmake/build/pdfmake.min.js"></script>
    <script src="@Domain/assets/libs/pdfmake/build/vfs_fonts.js"></script>
    <script src="@Domain/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="@Domain/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

    <script src="@Domain/assets/libs/dropzone/dropzone-min.js"></script>
    <script src="@Domain/ControllerJs/Definitions/ProductList.js"></script>
}

<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-xl modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="accordion" id="accordionExample">

                        <!-- Ürün Ana Bilgileri -->
                        <div class="accordion-item active">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                    Ürün Ana Bilgileri
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-6 col-sm-12">
                                            <div class="form-group">
                                                <label for="ProductName">Ürün Adı</label>
                                                <input type="text" class="form-control" id="ProductName" placeholder="Ürün Adı">
                                            </div>
                                            <div class="form-group">
                                                <label for="CategoryId">Kategori</label>
                                                <select id="CategoryId" class="form-control">
                                                    <option value="0">Seçiniz</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label for="StockQuantity">Stok</label>
                                                <input type="number" class="form-control" id="StockQuantity" placeholder="Stok">
                                            </div>
                                            <div class="form-group">
                                                <label for="Vat">Vergi</label>
                                                <input type="number" class="form-control" id="Vat" placeholder="Vergi">
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-sm-12">
                                            <div class="form-group">
                                                <label for="ProductCode">Ürün Kodu</label>
                                                <input type="text" class="form-control" id="ProductCode" placeholder="Ürün Kodu">
                                            </div>
                                            <div class="form-group">
                                                <label for="BrandId">Marka</label>
                                                <select id="BrandId" class="form-control">
                                                    <option value="0">Seçiniz</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label for="CurrencyId">Para Birimi</label>
                                                <select id="CurrencyId" class="form-control">
                                                    <option value="0">Seçiniz</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label for="IsActive">Durumu</label>
                                                <select id="IsActive" class="form-control">
                                                    <option value="0">Pasif</option>
                                                    <option value="1">Aktif</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12">
                                            <div class="form-group">
                                                <label for="Description">Ürün Açıklaması</label>
                                                <textarea class="form-control" rows="1" id="Description" placeholder="Ürün Açıklaması"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ürün Fiyat Bilgileri -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button fw-medium collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    Ürün Fiyat Bilgileri
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-2 col-sm-12">
                                            <div class="mb-3">
                                                <label for="unitType" class="form-label">Birim</label>
                                                <select id="unitType" class="form-select"></select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label for="Barcode" class="form-label">Barkod</label>
                                                <input type="text" class="form-control" id="Barcode" placeholder="">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label for="Count" class="form-label">içi Adet</label>
                                                <input type="number" min="1" class="form-control" id="Count" placeholder="">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label for="Price" class="form-label">Fiyat</label>
                                                <input type="number" step="0.01" class="form-control" id="Price" placeholder="">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label for="IsDefault" class="form-label">Varsayılan Mı?</label>
                                                <select id="IsDefault" class="form-select">
                                                    <option value="0">Hayır</option>
                                                    <option value="1">Evet</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label class="form-label">&nbsp;</label>
                                                <a id="addRowPrice" class="btn btn-primary text-white pull-left spc-form-btn mt-4">Yeni Satır Ekle</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <table class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;" id="priceTable">
                                            <thead>
                                                <tr>
                                                    <th>Birim</th>
                                                    <th>Barkod</th>
                                                    <th>içi Adet</th>
                                                    <th>Fiyat</th>
                                                    <th>Varsayılan</th>
                                                    <th width="40px"></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Resimler (Hem Dosya Hem URL Destekli) -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button fw-medium collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    Resimler
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-6 col-sm-12">
                                            <div class="mb-3">
                                                <label class="form-label">Resim Kaynağı</label>
                                                <ul class="nav nav-pills nav-justified mb-2" id="imageInputTabs" role="tablist">
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link active py-1" id="file-tab" data-bs-toggle="pill" data-bs-target="#file-panel" type="button" role="tab">Dosya Yükle</button>
                                                    </li>
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link py-1" id="url-tab" data-bs-toggle="pill" data-bs-target="#url-panel" type="button" role="tab">URL Gir</button>
                                                    </li>
                                                </ul>
                                                <div class="tab-content" id="imageInputTabsContent">
                                                    <div class="tab-pane fade show active" id="file-panel" role="tabpanel">
                                                        <div class="custom-file">
                                                            <input type="file" onchange="FileUpload(this)" class="form-control" id="ImgUrl">
                                                            <label class="custom-file-label" for="ImgUrl" id="ImageUrl"></label>
                                                        </div>
                                                    </div>
                                                    <div class="tab-pane fade" id="url-panel" role="tabpanel">
                                                        <input type="text" class="form-control" id="ImgUrlText" placeholder="https://ornek.com/resim.jpg">
                                                    </div>
                                                </div>
                                                <div id="SilinecekResimler"></div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-sm-12">
                                            <div class="mb-3">
                                                <label for="Queue" class="form-label">Sıra No</label>
                                                <input type="number" class="form-control" id="Queue" placeholder="1">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-sm-12">
                                            <div class="mb-3">
                                                <label class="form-label">&nbsp;</label>
                                                <a id="addRowImage" class="btn btn-primary text-white pull-left spc-form-btn mt-4">Yeni Satır Ekle</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <table class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;" id="imageTable">
                                            <thead>
                                                <tr>
                                                    <th>Resim</th>
                                                    <th width="120px">Sıra No</th>
                                                    <th width="40px"></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" onclick="CopyProduct()" class="btn btn-success" id="btnCopy">Kopyala</button>
                <button type="button" onclick="PostData(this)" class="btn btn-primary" id="btnSumbit">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="logModal" tabindex="-1" role="dialog" aria-labelledby="logModalLabel">
    <div class="modal-xl modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Uyarı ve Hatalar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <table class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;" id="logtables"></table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>