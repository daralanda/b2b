@using System.Configuration;
@using B2b.Infrastructure.Service.MainService
@inject IMainService _service;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Domain = Context.Request.Scheme + "://" + this.Context.Request.Host.Value;
}

<div class="row">
    <div class="col-md-12">
            <div id="mainSlider" class="owl-carousel owl-theme">
            @Html.Raw(_service.GetSliders())
            </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h4 class="section-title">En Son Eklenenler</h4>
    </div>
</div>
<div class="row">
    <div id="newProducts" class="owl-carousel owl-theme">

    </div>
</div>

<div class="row">
    @Html.Raw(_service.GetBanners())
   
</div>

<div class="row">
    <div class="col-md-12">
        <h4 class="section-title">Kampanyalı Ürünler</h4>
    </div>
</div>
<div class="row">
    <div id="saleProducts" class="owl-carousel owl-theme">
    </div>
</div>


@section scripts {
    <script src="@Domain/controllerjs/home/index.js"></script>
}


